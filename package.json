{
  "name": "@dnsdoctor/mcp",
  "version": "1.4.1",
  "mcpName": "dev.dnsdoctor/dns-doctor",
  "description": "Thin stdio MCP server for DNS Doctor \u2014 diagnoses SPF, DMARC, DKIM, MX, DNS, blacklist and expiry over the public DNS Doctor REST API.",
  "license": "Apache-2.0",
  "author": {
    "name": "DNS Doctor",
    "url": "https://dnsdoctor.dev"
  },
  "homepage": "https://dnsdoctor.dev/methodology",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnsdoctor/claude-plugin.git"
  },
  "keywords": [
    "mcp",
    "dns",
    "email",
    "spf",
    "dmarc",
    "dkim",
    "deliverability"
  ],
